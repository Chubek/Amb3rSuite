{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amb3r plugin proposal v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "abi": {
      "const": 1
    },
    "mode": {
      "enum": [
        "trusted-linked",
        "trusted-native",
        "isolated-native",
        "mune-worker",
        "on1x-native"
      ]
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "design.read",
          "diagnostics.emit",
          "commands.register",
          "design.propose",
          "jobs.run",
          "artifact.emit",
          "model.evaluate",
          "catalogue.read"
        ]
      },
      "maxItems": 32
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 32
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "version"
        ]
      },
      "maxItems": 64
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      },
      "required": [
        "memory_bytes",
        "deadline_ms"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "abi",
    "mode",
    "artifact_sha256",
    "required_capabilities",
    "facets",
    "dependencies",
    "limits"
  ]
}
